# Node dependencies — always reinstalled inside the image
node_modules

# Next.js build output — rebuilt inside the image
.next

# Test suite and coverage — not needed at runtime
tests
coverage
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Documentation
*.md

# Git history
.git
.gitignore

# Environment files — secrets must never be baked into the image
.env
.env.*
!.env.example

# Editor / OS artefacts
.DS_Store
*.log
npm-debug.log*

# CI configuration
.github
